# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 제출하거나 공유하지 않는다.

# 메일 서버 (Gmail: imap.gmail.com / 네이버: imap.naver.com / 다음: imap.daum.net)
MAIL_HOST=imap.gmail.com
MAIL_PORT=993
MAIL_USER=
# 계정 비밀번호가 아니라 메일 서비스에서 발급한 "앱 비밀번호"
MAIL_PASSWORD=

# 읽을 메일함. 쉼표로 여러 개. 이름 확인: python scripts/collect_mail.py --list-folders
# 네이버는 본인 메일이 따로 쌓이므로 INBOX,내게쓴메일함 처럼 함께 적는다.
MAIL_FOLDERS=INBOX

# 내 주소(쉼표로 여러 개). 본인이 본인에게 보낸 메일을 구분하는 데 쓴다.
MY_ADDRESSES=

# 항상 업무로 볼 도메인·주소 / 항상 광고로 볼 도메인·주소 (쉼표로 여러 개)
# gmail.com, naver.com 처럼 누구나 쓰는 도메인은 적지 않는다.
TRUSTED_SENDERS=
BLOCKED_SENDERS=

# 보고서에 적을 작성자 이름
REPORT_AUTHOR=

# 팀 업무 다이어리. python join_team.py 를 실행하면 물어보고 채워 준다.
# 웹 앱 주소 (https://script.google.com/macros/s/.../exec)
DIARY_URL=
# 팀장이 나에게 발급한 업로드 열쇠 (T01. 로 시작). 다른 팀원과 함께 쓰지 않는다.
DIARY_TOKEN=
